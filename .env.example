# Copy to .env and fill in. .env is gitignored — do not commit secrets.
#
# Each variable should be `export` so scripts can `source .env` and have it
# inherited by subprocesses (huggingface-cli, apptainer exec, etc.).
#
# HF_TOKEN: token for private Hugging Face checkpoints or datasets.
# WANDB_API_KEY:    https://wandb.ai/authorize
# OPENAI_API_KEY:   https://platform.openai.com/api-keys
# OPENROUTER_API_KEY: https://openrouter.ai/keys
# TINKER_API_KEY:   https://tinker.thinkingmachines.dev (Tinker backend only)

export HF_TOKEN=hf_REPLACE_ME
export WANDB_API_KEY=REPLACE_ME
export OPENAI_API_KEY=REPLACE_ME
export OPENROUTER_API_KEY=REPLACE_ME
# export TINKER_API_KEY=REPLACE_ME
